---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
---

<BaseLayout title="Unique Variety Gallery — Officially Fawnia" description="A unique variety of creative photoshoots of Fawnia Mondey through the years.">
  <section class="container gallery-page">
    <header class="gallery-head" data-stagger>
      <p class="eyebrow">Gallery</p>
      <h1><span class="ghost-num" aria-hidden="true">06</span> Unique Variety</h1>
    </header>
    <GalleryGrid section="unique" label="Unique Variety" />
    <p class="back"><a href="/gallery">← All galleries</a></p>
  </section>
</BaseLayout>

<style>
  .gallery-page {
    padding-block: var(--space-section);
  }
  .gallery-head h1 {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin: 0;
  }
  .gallery-head .ghost-num {
    font-size: clamp(3rem, 7vw, 6rem);
  }
  .back {
    margin-top: var(--space-10);
  }
</style>
