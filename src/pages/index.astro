---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Marquee from '../components/Marquee.astro';
import Embed from '../components/Embed.astro';
import heroImage from '../assets/pages/home-hero.jpg';
import aboutImage from '../assets/pages/about-hero.jpg';
import videoCover from '../assets/videos/pole-work.jpg';
import galleryPole from '../assets/gallery/pole-dance/01-20130713_7504weblrg.jpg';
import galleryCompetition from '../assets/gallery/competition/01-c1b.jpg';
import galleryFashion from '../assets/gallery/fashion/01-PictureGroove-Fawnia-5254-web.jpg';
import galleryBikini from '../assets/gallery/bikini/01-IMG_2083.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const stats = [
  { num: '1994', label: 'Teaching pole since' },
  { num: '7', label: 'Instructional videos — the first of their kind' },
  { num: '25', label: 'Dance, figure, fitness & bikini competitions' },
  { num: '2011', label: 'Founded Pole Expo in Las Vegas' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Fawnia Mondey',
    alternateName: 'Fawnia Dietrich',
    url: Astro.site?.href ?? 'https://www.officiallyfawnia.com',
    description:
      'Pole dance pioneer, instructor and judge; fitness model, personal trainer, author and actress. Producer of the world’s first instructional pole dancing video and creator of the Pole Dance Instructors Certification (PDIC).',
    jobTitle: ['Pole Dance Instructor', 'Personal Trainer', 'Author', 'Actress'],
    knowsAbout: ['Pole dancing', 'Fitness', 'Personal training', 'Nutrition'],
    sameAs: [
      'https://www.facebook.com/fitnessfawnia',
      'https://www.linkedin.com/pub/fawnia-dietrich/16/278/740',
      'https://www.imdb.com/name/nm0597744/',
      'https://www.polefitnessstudio.com',
      'https://lasvegaspolerentals.com',
      'https://burlesquetogo.com',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Officially Fawnia',
    url: Astro.site?.href ?? 'https://www.officiallyfawnia.com',
  },
];
---

<BaseLayout
  title="Officially Fawnia — Pole Dance Pioneer & Fitness Model"
  description="My name is Fawnia. I am a pole dance instructor, fitness model, personal trainer, writer, producer and actress. Enjoy my galleries, articles and videos."
  schema={schema}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-stagger>
        <p class="eyebrow">Pole Dance Pioneer · Las Vegas</p>
        <h1>Fawnia<br /><span class="outline">Queen</span> of Pole</h1>
        <p class="hero-intro">
          My name is Fawnia. I am a pole dance instructor, fitness model, personal trainer, writer,
          producer and actress. Make yourself at home and enjoy my photo gallery, articles, and stop
          by my shop and check out my instructional pole dancing DVDs — the first of their kind.
        </p>
        <div class="hero-ctas">
          <Button href="/videos" variant="primary" size="lg">Shop videos</Button>
          <a href="/videos" class="btn-circle" aria-label="Watch the instructional videos">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M8 5v14l11-7z" />
            </svg>
          </a>
          <a href="/about" class="hero-more">About me</a>
        </div>
      </div>
      <div class="hero-media line-shape-wrap">
        <svg
          class="line-shape"
          width="420"
          height="420"
          viewBox="0 0 420 420"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M30 330 C 60 150, 220 40, 400 90"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
          <path
            d="M10 380 C 60 220, 240 90, 410 150"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            opacity="0.6"
          />
          <path
            d="M70 400 C 120 300, 260 190, 400 220"
            stroke="currentColor"
            stroke-width="0.75"
            stroke-linecap="round"
            opacity="0.35"
          />
        </svg>
        <Image
          src={heroImage}
          alt="Fawnia posing in a studio photoshoot"
          widths={[480, 768, 1280]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <Marquee
    items={['Fawnia', 'Pole Pioneer', 'Author', 'Trainer', 'Since 1994']}
    fillIndexes={[0]}
  />

  <!-- STATS -->
  <section class="container stats-section">
    <ul class="stats" data-stagger>
      {stats.map((stat) => (
        <li>
          <span class="ghost-num">{stat.num}</span>
          <span class="stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ABOUT TEASER -->
  <section class="container teaser">
    <div class="teaser-grid reveal">
      <figure class="teaser-media">
        <Image
          src={aboutImage}
          alt="Portrait of Fawnia Mondey"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="lazy"
        />
      </figure>
      <div class="teaser-copy">
        <p class="eyebrow">01 — About</p>
        <h2>The Woman Behind the Pole</h2>
        <p>
          Canadian born Fawnia Mondey is the pioneer of pole dancing instruction as she produced the
          world&rsquo;s first instructional video on how to pole dance. Since her start in 94 Fawnia has
          produced seven instructional DVDs, taught thousands of women worldwide, and owns &lsquo;Pole
          Fitness Studio&rsquo; in Las Vegas, NV. USA.
        </p>
        <Button href="/about" variant="ghost">Read my story</Button>
      </div>
    </div>
  </section>

  <!-- GALLERY TEASER -->
  <section class="container teaser">
    <div class="teaser-head reveal">
      <p class="eyebrow">02 — Gallery</p>
      <h2>Enjoy My Photo Gallery</h2>
    </div>
    <ul class="gallery-strip" data-stagger>
      <li>
        <a href="/gallery/pole-dance">
          <Image src={galleryPole} alt="Fawnia performing a pole dance move" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="lazy" />
          <span>Pole &amp; Dance</span>
        </a>
      </li>
      <li>
        <a href="/gallery/competition">
          <Image src={galleryCompetition} alt="Fawnia posing on stage at a fitness competition" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="lazy" />
          <span>Competition</span>
        </a>
      </li>
      <li>
        <a href="/gallery/fashion">
          <Image src={galleryFashion} alt="Fawnia posing in a fashion photoshoot" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="lazy" />
          <span>Fashion</span>
        </a>
      </li>
      <li>
        <a href="/gallery/bikini">
          <Image src={galleryBikini} alt="Fawnia modeling swimwear in a bikini photoshoot" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" loading="lazy" />
          <span>Bikini</span>
        </a>
      </li>
    </ul>
    <p class="teaser-link reveal"><a href="/gallery">All seven galleries →</a></p>
  </section>

  <!-- VIDEOS TEASER -->
  <section class="container teaser">
    <div class="teaser-grid teaser-grid--flip reveal">
      <figure class="teaser-media">
        <Image
          src={videoCover}
          alt="Pole Work instructional DVD cover featuring Fawnia Mondey"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="lazy"
        />
      </figure>
      <div class="teaser-copy">
        <p class="eyebrow">03 — Shop</p>
        <h2>Instructional Videos &amp; DVDs</h2>
        <p>
          Fawnia produced the world&rsquo;s first instructional pole dancing video, Pole Work, in 1998 —
          and went on to produce six more titles. Each is available to watch online, and most are
          also available on DVD.
        </p>
        <Button href="/videos" variant="primary">Browse the shop</Button>
      </div>
    </div>
  </section>

  <!-- SONG -->
  <section class="container teaser">
    <div class="teaser-head reveal">
      <p class="eyebrow">The Official Song</p>
      <h2>&ldquo;Fawnia&rdquo; — For the Queen of Pole</h2>
      <p class="teaser-sub">
        Written and produced for the Queen of Pole, by Rezarect and Lil Mama. We hope you like it,
        and share it with your friends!
      </p>
    </div>
    <div class="song reveal">
      <Embed type="youtube" id="WPnxLS5wgPY" title="FAWNIA — the official song by Rezarect and Lil Mama" />
    </div>
  </section>

  <!-- STUDIOS -->
  <section class="container teaser">
    <div class="teaser-head reveal">
      <p class="eyebrow">Studios</p>
      <h2>Learn With Fawnia in Las Vegas</h2>
    </div>
    <div class="studios" data-stagger>
      <article class="studio">
        <h3>Pole Fitness Studio</h3>
        <p>
          Learn from over 25 instructors specializing in pole dancing, lyra, aerial hammock, boot
          camp, hip hop, hula hoop, yoga, stretching and more! Call us to set up your next birthday
          or bachelorette party; yes we teach pole dancing parties 24/7. You can even rent a dance
          pole and purchase instructional DVDs on Pole Dancing for Fitness! We also offer the Pole
          Dance Instructor Certification (PDIC), and Lap Dance Instructor Certification (LDIC).
        </p>
        <Button href="https://www.polefitnessstudio.com" variant="ghost" external>Visit</Button>
      </article>
      <article class="studio">
        <h3>Pole Dancing Las Vegas</h3>
        <p>
          Book your private pole dancing party with us. Try our unlimited monthly membership with
          300 classes in Pole Dancing, Striptease, Yoga, Zumba, Booty Camp, Burlesque, Ballet and
          more!
        </p>
        <Button href="http://www.poledancinglasvegas.net" variant="ghost" external>Visit</Button>
      </article>
    </div>
  </section>

  <!-- BLOG TEASER -->
  <section class="container teaser">
    <div class="teaser-head reveal">
      <p class="eyebrow">04 — News &amp; Articles</p>
      <h2>Latest From the Blog</h2>
    </div>
    <ul class="post-list" data-stagger>
      {posts.slice(0, 4).map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
    <p class="teaser-link reveal"><a href="/blog">Read all articles →</a></p>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-block: var(--space-section);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  h1 .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-pink-light);
  }
  .hero-intro {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
    margin-block: var(--space-6);
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .hero-more {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .hero-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }

  /* STATS */
  .stats-section {
    padding-block: var(--space-section);
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10) var(--space-8);
  }
  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats li {
    display: grid;
    gap: var(--space-3);
  }
  .stat-label {
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 700;
    max-width: 24ch;
  }

  /* TEASERS */
  .teaser {
    padding-block: var(--space-16);
  }
  .teaser-head {
    max-width: 70ch;
    margin-bottom: var(--space-10);
  }
  .teaser-sub {
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .teaser-grid {
      grid-template-columns: 1fr 1fr;
    }
    .teaser-grid--flip .teaser-media {
      order: 2;
    }
  }
  .teaser-media {
    margin: 0;
  }
  .teaser-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }
  .teaser-copy p:not(.eyebrow) {
    color: var(--color-text-muted);
    max-width: 55ch;
    margin-block: var(--space-5);
  }
  .teaser-link {
    margin-top: var(--space-8);
  }

  /* GALLERY STRIP */
  .gallery-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .gallery-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery-strip a {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .gallery-strip :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .gallery-strip a:hover :global(img) {
    transform: scale(1.05);
  }
  .gallery-strip span {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-6) var(--space-4) var(--space-3);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
    color: var(--color-pink-light);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  /* SONG */
  .song {
    max-width: 820px;
  }

  /* STUDIOS */
  .studios {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  @media (min-width: 768px) {
    .studios {
      grid-template-columns: 1fr 1fr;
    }
  }
  .studio {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }
  .studio p {
    color: var(--color-text-muted);
    margin-block: var(--space-4) var(--space-6);
  }

  /* BLOG LIST */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .post-list li {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-5);
  }
  .post-list a {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-decoration: none;
  }
  .post-list a:hover {
    color: var(--color-pink-light);
  }
  .post-list time {
    display: block;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 700;
    margin-top: var(--space-2);
  }
  .post-list p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    max-width: 70ch;
  }
</style>
