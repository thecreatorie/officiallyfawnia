---
import { Image } from 'astro:assets';
import galleries from '../data/galleries.json';

export interface Props {
  section: keyof typeof galleries;
  label?: string;
}

const { section, label } = Astro.props;
const caption = label ?? String(section);

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/**/*.{jpg,jpeg,png,JPG,JPEG}',
  { eager: true }
);

const items = (galleries[section] ?? []).map((item) => {
  const key = Object.keys(modules).find((k) => k.endsWith(`/gallery/${section}/${item.file}`));
  return key ? { image: modules[key].default, alt: item.alt } : null;
}).filter((x): x is { image: ImageMetadata; alt: string } => x !== null);
---

<ul class="gallery-grid reveal">
  {items.map(({ image, alt }, i) => (
    <li>
      <figure>
        <Image
          src={image}
          alt={alt}
          widths={[320, 480, 768]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
        <figcaption aria-hidden="true">
          {caption} <span class="num">/ {String(i + 1).padStart(2, '0')}</span>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .gallery-grid {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    columns: 1;
    column-gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .gallery-grid {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .gallery-grid {
      columns: 3;
    }
  }
  .gallery-grid li {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
  .gallery-grid figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .gallery-grid :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .gallery-grid figure:hover :global(img) {
    transform: scale(1.04);
  }
  .gallery-grid figcaption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.8));
    color: var(--color-pink-light);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: var(--fs-xs);
    font-weight: 700;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  .gallery-grid figure:hover figcaption,
  .gallery-grid figure:focus-within figcaption {
    opacity: 1;
  }
  .gallery-grid .num {
    color: var(--color-text-subtle);
  }
  @media (hover: none) {
    .gallery-grid figcaption {
      display: none;
    }
  }
</style>
