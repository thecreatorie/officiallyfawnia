---
const items = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Résumé', href: '/resume' },
  { label: 'Fitness', href: '/fitness' },
  { label: 'Blog', href: '/blog' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Videos', href: '/videos' },
  { label: 'Contact', href: '/contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  pathname === href || (href !== '/' && pathname.startsWith(href));
---

<div class="mobile-nav-wrap">
  <button id="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Open menu">
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
    </svg>
  </button>

  <div id="mobile-nav-drawer" class="drawer" hidden>
    <nav aria-label="Mobile primary">
      <ul>
        {items.map(item => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  .mobile-nav-wrap button {
    background: transparent;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-md);
    /* 44x44 minimum touch target */
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-nav-wrap button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .mobile-nav-wrap { display: none; }
  }

  .drawer {
    /* Full-screen fixed panel below the sticky header (header z-index 70),
       so the hamburger toggle in the header stays tappable while open. */
    position: fixed;
    inset: 0;
    /* Bulletproof FULLY OPAQUE panel — literal hex (not a var), no blur. */
    background: #050505;
    background-clip: padding-box;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding: calc(72px + var(--space-4)) var(--space-5) var(--space-8);
    z-index: 60;
    overflow-y: auto;
  }

  .drawer[hidden] { display: none; }

  .drawer nav {
    /* Subtle brand border marking the top of the menu panel */
    border-top: 1px solid color-mix(in oklab, var(--color-primary) 45%, var(--color-border));
    padding-top: var(--space-4);
  }

  .drawer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .drawer a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-md);
    border-left: 3px solid transparent;
  }

  .drawer a:hover {
    background: var(--color-surface);
  }

  .drawer a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .drawer a[aria-current='page'] {
    color: var(--color-champagne-light);
    border-left-color: var(--color-primary);
    background: var(--color-surface);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        drawer.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        const first = drawer.querySelector('a');
        (first as HTMLElement | null)?.focus();
      } else {
        drawer.setAttribute('hidden', '');
        document.body.style.overflow = '';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close when a menu link is tapped
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
