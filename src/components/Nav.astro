---
const items = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Résumé', href: '/resume' },
  { label: 'Fitness', href: '/fitness' },
  { label: 'Blog', href: '/blog' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Videos', href: '/videos' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="primary-nav" aria-label="Primary">
  <ul>
    {items.map(item => {
      const current = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
      return (
        <li>
          <a href={item.href} aria-current={current ? 'page' : undefined}>{item.label}</a>
        </li>
      );
    })}
    <li>
      <a
        href="/contact"
        class="nav-cta"
        aria-current={pathname.startsWith('/contact') ? 'page' : undefined}
      >Contact</a>
    </li>
  </ul>
</nav>

<style>
  .primary-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .primary-nav {
      display: block;
    }

    .primary-nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .primary-nav a:not(.nav-cta) {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 700;
      font-size: var(--fs-sm);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: var(--space-2) 0;
      border-bottom: 2px solid transparent;
      transition: color var(--duration-fast) var(--ease-out),
                  border-color var(--duration-fast) var(--ease-out);
    }

    .primary-nav a:not(.nav-cta):hover,
    .primary-nav a:not(.nav-cta)[aria-current='page'] {
      color: var(--color-champagne-light);
      border-bottom-color: var(--color-primary);
    }

    .nav-cta {
      display: inline-block;
      background: var(--color-primary);
      color: #0a0a0a;
      font-weight: 700;
      font-size: var(--fs-sm);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      text-decoration: none;
      padding: var(--space-2) var(--space-6);
      border-radius: var(--radius-full);
      transition: background var(--duration-fast) var(--ease-out);
    }

    .nav-cta:hover,
    .nav-cta[aria-current='page'] {
      background: var(--color-champagne-light);
    }
  }
</style>
